# Copie para .env (que é gitignored) e preencha.
# Bot próprio: fale com @BotFather no Telegram -> /newbot -> copie o token.
TELEGRAM_BOT_TOKEN=

# Chat que recebe as vagas: mande qualquer mensagem pro seu bot e abra
# https://api.telegram.org/bot<SEU_TOKEN>/getUpdates — o id está em
# result[0].message.chat.id
TELEGRAM_CHAT_ID=

# Intervalo entre ciclos quando roda em loop (sem --once). O workflow do
# GitHub Actions usa o cron dele e ignora isso.
INTERVALO_MINUTOS=180
